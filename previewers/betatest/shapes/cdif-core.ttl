@prefix rdf:         <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:        <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:          <http://www.w3.org/ns/shacl#> .
@prefix xsd:         <http://www.w3.org/2001/XMLSchema#> .
@prefix schema:      <http://schema.org/> .
@prefix dcterms:     <http://purl.org/dc/terms/> .
@prefix cdifd:       <https://cdif.org/validation/0.1/shacl#> .
@base <https://www.ogc.org/rules/template/> .

# ====================================================================
# CDIF Discovery Core SHACL Shapes
# Converted to Core SHACL (no SPARQL features)
# ====================================================================

cdifd:CDIFDatasetMandatoryShape a sh:NodeShape ;
    # Converted from sh:SPARQLTarget to sh:targetClass
    # Original: Selected root Dataset nodes (without parent Dataset, excluding schema:about)
    # Core SHACL: Validates all schema:Dataset instances
    sh:targetClass schema:Dataset ;
    
    sh:property	
        cdifd:resourceIdentifierProperty,
        cdifd:nameProperty,
        cdifd:rightsProperty,
        cdifd:dateModifiedProperty ;
    
    sh:message "Mandatory properties for CDIF Dataset documentation." .

cdifd:resourceIdentifierProperty
    # identifier for the resource described by the graph node, implement as either xsd:string or 
    # schema:PropertyValue with required [either schema:url or schema:value]
    a sh:PropertyShape ;
    sh:path schema:identifier ;
    sh:minCount 1 ;
    sh:or ( 
        [ sh:datatype xsd:string ; ]
        [ sh:class schema:PropertyValue ;
            sh:property 
                [ sh:path schema:propertyID ;
                  sh:datatype xsd:string ;
                  sh:severity sh:Warning ;
                  sh:message "If specifying an identifier via the PropertyValue, the scheme (authority, domain) within which the identifier is assigned and unique must be identified, either by name or preferably using a URI. See https://registry.identifiers.org/registry" ] ;
            sh:or (
                [ sh:property 
                    [ sh:path schema:url ;
                      sh:datatype xsd:string ;
                      sh:message "If possible, provide a resolvable URI that will provide a representation of the identified resource." ] ]
                [ sh:property 
                    [ sh:path schema:value ;
                      sh:datatype xsd:string ;
                      sh:message "The identifier string; include applicable prefix (e.g. doi:, ark:, http:, isbn:)" ] ]
            ) ]
    ) ;
    sh:message "An identifier for the documented resource must be provided" .

cdifd:nameProperty
    # names must be a literal
    a sh:PropertyShape ;
    sh:path schema:name ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:minLength 5 ;
    sh:message "A name for the resource must be provided, and have a length of at least 5 characters." .
    
cdifd:rightsProperty	
    a sh:PropertyShape ;
    # some indication of rights is required, either a license or statement on conditions of access
    sh:path [ sh:alternativePath ( schema:license schema:conditionsOfAccess ) ] ;
    sh:or (
        [ sh:nodeKind sh:IRI ]
        [ sh:datatype xsd:string ]
        # use schema:CreativeWork to implement a labeled link, only URL is required, but schema:name is expected
        [ sh:class schema:CreativeWork ;
          sh:property 
            [ sh:path schema:url ;
              sh:minCount 1 ;
              sh:datatype xsd:string ;
              sh:pattern "^https?:\\/\\/[^\\s]+$" ;
              sh:message "Value must be a resolvable URL, but we aren't testing to see if the URL resolves..... Can't get xsd:anyURI to work with JSON Schema validation..." ] ]
    ) ;
    sh:minCount 1 ;
    sh:message "To meet the requirements for FAIR data, information about licenses or other security, usage, or access limitations must be described" .
	
cdifd:dateModifiedProperty
    a sh:PropertyShape ;
    sh:path schema:dateModified ;
    # pyshacl doesn't seem to work validating xsd:date or xsd:dateTime in JSON-LD
    # sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    # messy regex to screen for ISO8601 formats
    sh:pattern "^[1-2][0-9]{3}-([0][1-9]|[1][0-2])(-([0-2][0-9]|[3][0-1])(T([0-1][0-9]|[2][0-3]):[0-5][0-9](:[0-5][0-9](Z|[+-][0-2][0-9]:[0-5][0-9])?)?)?)?$" ;
    sh:message "Date of most recent update to resource content is required, using ISO8601 format with at least a year and a month." .
    
cdifd:CDIFMetaMetadataShape
    a sh:NodeShape ;
    # Converted from sh:SPARQLTarget to sh:targetSubjectsOf
    # Original: Selected Dataset nodes that have schema:about property
    # Core SHACL: Targets all subjects that have schema:about predicate
    sh:targetSubjectsOf schema:about ;
    
    # Additional constraint: must be a schema:Dataset
    sh:class schema:Dataset ;
    
    sh:nodeKind sh:IRI ;
    sh:property cdifd:metadataProfileProperty ;
    sh:property cdifd:metadataSubjectProperty ;
    sh:message "Metadata about metadata: the target of the metadata record (about)." .

cdifd:metadataProfileProperty
    # Metadata needs to identify conventions followed in the serialization of this record.
    a sh:PropertyShape ;
    sh:path dcterms:conformsTo ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "Provide identifiers for specifications used in this record to provide guidance for machine agents processing the metadata record" .
    
cdifd:metadataSubjectProperty
    # Metadata needs to identify the subject of the metadata record
    a sh:PropertyShape ;
    sh:path schema:about ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:message "Link to the target of the metadata metadata node using the about property" .

# ====================================================================
# Recommended Schema.org Properties (Optional)
# ====================================================================

cdifd:CDIFDatasetRecommendedShape a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    
    sh:property
        cdifd:urlProperty,
        cdifd:descriptionProperty,
        cdifd:contributorProperty,
        cdifd:creatorProperty,
        cdifd:keywordsProperty,
        cdifd:distributionProperty,
        cdifd:measurementTechniqueProperty,
        cdifd:variableMeasuredProperty,
        cdifd:subjectOfProperty,
        cdifd:startDateProperty,
        cdifd:locationProperty,
        cdifd:mainEntityProperty,
        cdifd:additionalPropertyProperty,
        cdifd:relatedLinkProperty,
        cdifd:additionalTypeProperty,
        cdifd:emailProperty ;
    
    sh:message "Recommended properties for rich dataset documentation using schema.org vocabulary." .

cdifd:urlProperty
    a sh:PropertyShape ;
    sh:path schema:url ;
    sh:or (
        [ sh:nodeKind sh:IRI ]
        [ sh:datatype xsd:string ]
    ) ;
    sh:message "URL of the resource or dataset landing page" .

cdifd:descriptionProperty
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:datatype xsd:string ;
    sh:message "A description of the dataset content and purpose" .

cdifd:contributorProperty
    a sh:PropertyShape ;
    sh:path schema:contributor ;
    sh:or (
        [ sh:class schema:Person ]
        [ sh:class schema:Organization ]
        [ sh:class schema:Role ]
    ) ;
    sh:message "A person or organization that contributed to the dataset" .

cdifd:creatorProperty
    a sh:PropertyShape ;
    sh:path schema:creator ;
    sh:or (
        [ sh:class schema:Person ]
        [ sh:class schema:Organization ]
    ) ;
    sh:message "The creator or author of the dataset" .

cdifd:keywordsProperty
    a sh:PropertyShape ;
    sh:path schema:keywords ;
    sh:or (
        [ sh:datatype xsd:string ]
        [ sh:class schema:DefinedTerm ]
    ) ;
    sh:message "Keywords or tags describing the dataset" .

cdifd:distributionProperty
    a sh:PropertyShape ;
    sh:path schema:distribution ;
    sh:or (
        [ sh:class schema:DataDownload ]
        [ sh:nodeKind sh:IRI ]
    ) ;
    sh:message "A downloadable form of the dataset" .

cdifd:measurementTechniqueProperty
    a sh:PropertyShape ;
    sh:path schema:measurementTechnique ;
    sh:or (
        [ sh:class schema:DefinedTerm ]
        [ sh:datatype xsd:string ]
        [ sh:nodeKind sh:IRI ]
    ) ;
    sh:message "The technique or methodology used to gather the data" .

cdifd:variableMeasuredProperty
    a sh:PropertyShape ;
    sh:path schema:variableMeasured ;
    sh:or (
        [ sh:class schema:PropertyValue ]
        [ sh:datatype xsd:string ]
    ) ;
    sh:message "Variables that are measured in the dataset" .

cdifd:subjectOfProperty
    a sh:PropertyShape ;
    sh:path schema:subjectOf ;
    sh:class schema:Dataset ;
    sh:message "A CreativeWork or Dataset about this item (metadata about metadata)" .

cdifd:startDateProperty
    a sh:PropertyShape ;
    sh:path schema:startDate ;
    sh:or (
        [ sh:datatype xsd:dateTime ]
        [ sh:datatype xsd:date ]
        [ sh:datatype xsd:string ]
    ) ;
    sh:message "The start date and time of an event or action" .

cdifd:locationProperty
    a sh:PropertyShape ;
    sh:path schema:location ;
    sh:class schema:Place ;
    sh:message "The location where the event or action took place" .

cdifd:mainEntityProperty
    a sh:PropertyShape ;
    sh:path schema:mainEntity ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:message "The primary entity described by the content" .

cdifd:additionalPropertyProperty
    a sh:PropertyShape ;
    sh:path schema:additionalProperty ;
    sh:class schema:PropertyValue ;
    sh:message "Additional properties as name-value pairs" .

cdifd:relatedLinkProperty
    a sh:PropertyShape ;
    sh:path schema:relatedLink ;
    sh:or (
        [ sh:nodeKind sh:IRI ]
        [ sh:class schema:LinkRole ]
    ) ;
    sh:message "Related links or resources" .

cdifd:additionalTypeProperty
    a sh:PropertyShape ;
    sh:path schema:additionalType ;
    sh:or (
        [ sh:nodeKind sh:IRI ]
        [ sh:datatype xsd:string ]
    ) ;
    sh:message "An additional type for the item, typically used for adding more specific types" .

cdifd:emailProperty
    a sh:PropertyShape ;
    sh:path schema:email ;
    sh:datatype xsd:string ;
    sh:message "Email address" .
